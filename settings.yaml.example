# raft operator settings — copy to ~/.raft/settings.yaml (created on first use with defaults).
# Override the data home with RAFT_DATA_HOME (default: ~/.raft).

logging:
  # Directory for log files (relative to the data home, or absolute).
  # Override with env RAFT_LOG_DIR.
  # Terminal output is always plain text; only this file uses log formatting.
  dir: logs
  file: raft.log
  level: INFO   # DEBUG | INFO | WARNING | ERROR
